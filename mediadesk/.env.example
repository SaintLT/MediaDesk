# Copy to .env.local for local development, and add the same two variables in Vercel
# (Project -> Settings -> Environment Variables).
#
# Find both in Supabase: Project Settings -> API.
# Use the "anon / public" key ONLY. Never put the service_role key in this app or in Vercel's frontend variables.
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key